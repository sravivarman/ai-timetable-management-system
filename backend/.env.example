APP_NAME=AI Timetable Management System
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/timetable_db

# Generate a long random value for every environment.
SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Required to establish the initial Report Viewer credential during seeding.
# Leave unset to create the account with an unusable random credential, then reset it as Administrator.
REPORT_VIEWER_INITIAL_PASSWORD=
