# Application
APP_NAME=AI Timetable Management System
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+psycopg://postgres:root@localhost:5432/timetable_db

# Security: replace with a long, random value before deployment.
SECRET_KEY=change-this-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ALGORITHM=HS256
